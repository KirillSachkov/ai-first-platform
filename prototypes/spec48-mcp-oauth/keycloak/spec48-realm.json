      "firstName": "Анна",
      "lastName": "Тестова",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "anna-pass", "temporary": false }],
      "realmRoles": ["default-roles-spec48"]
    },
    {
      "username": "boris",
      "email": "boris@example.test",
      "emailVerified": true,
      "firstName": "Борис",
      "lastName": "Тестов",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "boris-pass", "temporary": false }],
      "realmRoles": ["default-roles-spec48"]
    }
  ]
