# Copy to .env for local development. Values below are local-only examples, not real secrets.
# Passwords are embedded in connection URLs, so keep them URL-safe.

# PostgreSQL. POSTGRES_USER owns the database and applies migrations;
# the application connects as POSTGRES_APP_USER with data-only privileges.
POSTGRES_DB=platform
POSTGRES_USER=platform_migrations
POSTGRES_PASSWORD=local-migrations-password
POSTGRES_APP_USER=platform_app
POSTGRES_APP_PASSWORD=local-app-password

# RabbitMQ.
RABBITMQ_DEFAULT_USER=platform
RABBITMQ_DEFAULT_PASS=local-rabbitmq-password

# Host ports, bound to 127.0.0.1 only. Non-default Postgres and API ports avoid clashes with other local stacks.
POSTGRES_HOST_PORT=5433
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
API_HOST_PORT=3100
WEB_HOST_PORT=5173

# Backend settings, validated at startup by apps/api/src/shared/config/config.ts.
# Compose overrides the URLs with container hostnames; these values serve apps running on the host.
DATABASE_URL=postgres://platform_app:local-app-password@127.0.0.1:5433/platform
MIGRATIONS_DATABASE_URL=postgres://platform_migrations:local-migrations-password@127.0.0.1:5433/platform
RABBITMQ_URL=amqp://platform:local-rabbitmq-password@127.0.0.1:5672
HTTP_HOST=127.0.0.1
HTTP_PORT=3100
LOG_LEVEL=info

# Frontend dev server proxy target for /api.
API_PROXY_TARGET=http://127.0.0.1:3100
