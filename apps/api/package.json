{
  "name": "@platform/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "db:generate": "tsx scripts/db-generate.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "openapi:generate": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "lint": "oxlint",
    "boundaries": "depcruise src --output-type err-long"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-fastify": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "amqplib": "2.2.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@platform/oxlint-config": "workspace:*",
    "@platform/typescript-config": "workspace:*",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.7.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
