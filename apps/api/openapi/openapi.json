  "openapi": "3.0.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "HealthEndpoint_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "system"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthEndpoint_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Every dependency is available",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready",
                        "unavailable"
                      ]
                    },
                    "dependencies": {
                      "type": "object",
                      "properties": {
                        "database": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "ok",
                                "unavailable"
                              ]
                            },
                            "error": {
                              "description": "Why the check failed; absent when the dependency is ok.",
                              "type": "string"
                            }
                          },
                          "required": [
                            "status"
                          ],
                          "additionalProperties": false
                        },
                        "rabbitmq": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "ok",
                                "unavailable"
                              ]
                            },
                            "error": {
                              "description": "Why the check failed; absent when the dependency is ok.",
                              "type": "string"
                            }
                          },
                          "required": [
                            "status"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "database",
                        "rabbitmq"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "status",
                    "dependencies"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "At least one dependency is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready",
                        "unavailable"
                      ]
                    },
                    "dependencies": {
                      "type": "object",
                      "properties": {
                        "database": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "ok",
                                "unavailable"
                              ]
                            },
                            "error": {
                              "description": "Why the check failed; absent when the dependency is ok.",
                              "type": "string"
                            }
                          },
                          "required": [
                            "status"
                          ],
                          "additionalProperties": false
                        },
                        "rabbitmq": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "ok",
                                "unavailable"
                              ]
                            },
                            "error": {
                              "description": "Why the check failed; absent when the dependency is ok.",
                              "type": "string"
                            }
                          },
                          "required": [
                            "status"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "database",
                        "rabbitmq"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "status",
                    "dependencies"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "system"
        ]
      }
    },
    "/system/status": {
      "get": {
        "operationId": "GetSystemStatusEndpoint_getSystemStatus",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Service identity and dependency state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "serverTime": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "dependencies": {
                      "type": "object",
                      "properties": {
                        "database": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "unavailable"
                          ]
                        },
                        "rabbitmq": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "unavailable"
                          ]
                        }
                      },
                      "required": [
                        "database",
                        "rabbitmq"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "service",
                    "version",
                    "serverTime",
                    "dependencies"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "system"
        ]
      }
    }
  },
