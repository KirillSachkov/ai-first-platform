{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@platform/oxlint-config/node.json"],
  // Options apply only in the root config of a run, so each app sets them.
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "overrides": [
    {
      // The root module imports every domain and technical module by design.
      "files": ["src/app.module.ts"],
      "rules": { "import/max-dependencies": "off" }
    },
    {
      // Application code reads the current time from the injectable clock (apps/api/AGENTS.md).
      "files": ["src/**"],
      "rules": { "platform/no-current-time": "error" }
    },
    {
      // The system clock reads the real time; tests control time through the clock or fake timers.
      "files": ["src/shared/time/clock.ts", "src/**/*.test.ts"],
      "rules": { "platform/no-current-time": "off" }
    }
  ]
}
