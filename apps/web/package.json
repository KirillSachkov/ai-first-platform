{
  "name": "@platform/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "api:generate": "openapi-typescript ../api/openapi/openapi.json --output src/shared/api/schema.gen.ts",
    "api:check": "openapi-typescript ../api/openapi/openapi.json --output src/shared/api/schema.gen.ts --check",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "boundaries": "steiger ./src"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "clsx": "2.1.1",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.8.1",
    "@platform/oxlint-config": "workspace:*",
    "@platform/typescript-config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.48",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "steiger": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
