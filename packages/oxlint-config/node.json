{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["./base.json"],
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "vitest", "node"],
  "rules": {
    // Selected restriction rules.
    "node/handle-callback-err": "error",
    "node/no-new-require": "error",
    "node/no-path-concat": "error",

    // Disabled rules.
    // The backend is a Node.js application; built-in modules are its platform.
    "import/no-nodejs-modules": "off",
    // A NestJS module file declares the module together with the providers only it uses.
    "eslint/max-classes-per-file": "off"
  },
  "overrides": [
    {
      // One-shot developer scripts run sequentially; synchronous calls keep them simple.
      "files": ["scripts/**"],
      "rules": { "node/no-sync": "off" }
    }
  ]
}
